// Settings for running the LTEE pipeline on a laptop.
// Adapted from https://khanlab.bio/cbio7501-f26/pages/10-nextflow.html
// Software comes from the locked Pixi environment that launches Nextflow.

outputDir = 'results/nextflow'

workflow.output.mode = 'copy'

process {
    cpus = 1
    // Lower ALIGN's four-CPU request on machines with fewer available CPUs.
    resourceLimits = [cpus: Runtime.runtime.availableProcessors()]
}
